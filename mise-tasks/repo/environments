#!/usr/bin/env bash
#MISE description="Create or update the release environment, limited to v* release tags"

set -euo pipefail
cd "${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
environment=release
tag_pattern='v*'

jq -n '{
	can_admins_bypass: true,
	deployment_branch_policy: {protected_branches: false, custom_branch_policies: true}
}' | gh api --method PUT "repos/$repo/environments/$environment" --input - >/dev/null

policies="repos/$repo/environments/$environment/deployment-branch-policies"
existing="$(gh api "$policies" --jq ".branch_policies[] | select(.type == \"tag\" and .name == \"$tag_pattern\") | .id")"
if [[ -z "$existing" ]]; then
	gh api --method POST "$policies" -f name="$tag_pattern" -f type=tag >/dev/null
fi

printf 'Environment %s on %s deploys only from tags matching %s.\n' "$environment" "$repo" "$tag_pattern"
printf 'Set the environment to %s in each registry'\''s trusted publisher config.\n' "$environment"
