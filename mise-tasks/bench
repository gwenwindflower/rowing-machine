#!/usr/bin/env bash
#MISE description="Benchmark ecommerce CSV with one worker and all cores, including peak memory"

set -euo pipefail
cd "${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

artifacts="$(mktemp "${TMPDIR:-/tmp}/rowing-bench.XXXXXX")"
trap 'rm -f "$artifacts"' EXIT
cargo bench --bench ecommerce --no-run --locked --message-format=json >"$artifacts"
benchmark="$(jq -er 'select(.reason == "compiler-artifact" and .target.name == "ecommerce" and .executable != null) | .executable' "$artifacts")"

printf 'Peak memory covers the Criterion process, including warmup and row counting; compilation is excluded.\n'
for scale in 10 100; do
	for workers in workers_1 workers_available; do
		printf '\nScale: %s; worker setting: %s\n' "$scale" "$workers"
		case "$(uname -s)" in
			Darwin) /usr/bin/time -l "$benchmark" --bench --exact "ecommerce/seed42_scale${scale}_years4_csv/$workers" "$@" ;;
			Linux) /usr/bin/time -v "$benchmark" --bench --exact "ecommerce/seed42_scale${scale}_years4_csv/$workers" "$@" ;;
			*) printf 'Peak memory reporting requires macOS or Linux.\n' >&2; exit 1 ;;
		esac
	done
done
